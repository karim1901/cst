# ---------------------------------------------------------------------------
# MongoDB Atlas connection string.
# Atlas UI: Database > Connect > Drivers. Replace <username>, <db_password>,
# <cluster> and <database> with your own values. Never commit real credentials.
# ---------------------------------------------------------------------------
MONGODB_URI="mongodb+srv://<username>:<db_password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority&appName=<app_name>"

# Optional — only if `mongodb+srv://` fails with "querySrv ECONNREFUSED" because
# your network's DNS resolver does not answer SRV queries. Forces the SRV lookup
# through public resolvers instead.
# MONGODB_DNS_SERVERS="8.8.8.8,1.1.1.1"

# ---------------------------------------------------------------------------
# Auth — secret used to sign session JWTs (HS256).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Must be at least 32 characters. Rotating it invalidates all existing sessions.
# ---------------------------------------------------------------------------
JWT_SECRET="replace-with-a-long-random-string-at-least-32-chars"

# ---------------------------------------------------------------------------
# Initial Super Admin — used ONLY by `npm run seed:super-admin`.
# The seed is idempotent: running it again with the same email does nothing.
# Never hardcode the real password anywhere in source.
# ---------------------------------------------------------------------------
SUPER_ADMIN_NAME="Platform Owner"
SUPER_ADMIN_EMAIL="admin@example.com"
SUPER_ADMIN_PASSWORD="replace-with-a-strong-password"

# ---------------------------------------------------------------------------
# Encrypts secrets at rest (AES-256-GCM) — an employee's Quick Livraison API
# key, and the platform's own ShippingCompany provider keys (Ozon Express,
# Quick Livraison). Must be a base64 string that decodes to exactly 32 bytes.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this key makes every previously-stored secret undecryptable — treat
# it like any other production secret.
# ---------------------------------------------------------------------------
SECRET_ENCRYPTION_KEY="replace-with-a-base64-32-byte-key"

# ---------------------------------------------------------------------------
# Ozon Express API base URL. Only override this for local testing against a
# mock server — production always uses the real api.ozonexpress.ma.
# ---------------------------------------------------------------------------
# OZON_API_BASE="https://api.ozonexpress.ma"

# ---------------------------------------------------------------------------
# Quick Livraison API base URL. Only override this for local testing against
# a mock server — production always uses the real clients.quicklivraison.ma/api.
# ---------------------------------------------------------------------------
# QUICK_API_BASE="https://clients.quicklivraison.ma/api"

# ---------------------------------------------------------------------------
# Secures the automatic Ozon reconciliation cron endpoint
# (app/api/cron/daily-reconcile/route.js — see vercel.json's `crons` entry).
# The scheduler must send this exact value as `Authorization: Bearer
# <CRON_SECRET>` (Vercel Cron does this automatically once this variable is
# set in the project — see https://vercel.com/docs/cron-jobs/manage-cron-jobs#securing-cron-jobs;
# any other scheduler must be configured to send the same header). Without
# this set, the endpoint refuses every request — there is no insecure
# fallback. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ---------------------------------------------------------------------------
CRON_SECRET="replace-with-a-random-secret"
